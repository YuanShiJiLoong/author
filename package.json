{
  "name": "author-app",
  "version": "1.2.62",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "sync:legal": "node scripts/sync-legal-docs.mjs",
    "predev": "npm run sync:legal",
    "dev": "next dev",
    "prebuild": "npm run sync:legal",
    "build": "next build",
    "postbuild": "node scripts/check-standalone-safety.js",
    "start": "next start",
    "lint": "node scripts/check-lint.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ai-routing": "node --test tests/ai-provider-compat.test.mjs",
    "test:built-in-labels": "node --test tests/built-in-labels.test.mjs",
    "test:chat-markdown": "node --test tests/chat-markdown.test.mjs",
    "test:remarks": "node --test tests/remarks.test.mjs",
    "test:security": "node --test tests/server-security.test.mjs",
    "test:synopsis-language": "node --test tests/synopsis-prompts.test.mjs",
    "test:local-save": "node --test tests/local-save-status.test.mjs",
    "check": "npm run lint && npm test && npm run check:open-core-boundary && npm run build",
    "check:open-core-boundary": "node scripts/check-open-core-boundary.js",
    "check:secrets": "node scripts/check-secrets.mjs tree",
    "check:secrets:history": "node scripts/check-secrets.mjs history",
    "check:secrets:artifact": "node scripts/check-secrets.mjs artifact",
    "check:secrets:docker": "node scripts/check-docker-secrets.mjs",
    "check:secrets:electron": "node scripts/check-electron-secrets.mjs",
    "test:secret-scanner": "node --test tests/integration/secret-scanner.mjs",
    "test:electron-secret-scanner": "node --test tests/integration/electron-secret-scanner.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "node -e \"const fs=require('fs');['dist','.next'].forEach(d=>{if(fs.existsSync(d)){fs.rmSync(d,{recursive:true,force:true})}})\" && npm run build && npx electron-builder --win",
    "electron:start": "npx electron ."
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-character-count": "3.32.0",
    "@tiptap/extension-color": "3.32.0",
    "@tiptap/extension-font-family": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "docx": "^9.6.0",
    "electron-updater": "6.8.9",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.28",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.11.0",
    "next": "16.3.8",
    "pdf-parse": "^1.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tiptap-markdown": "^0.9.0",
    "tokenx": "^1.3.0",
    "undici": "7.30.1",
    "word-extractor": "^1.0.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "electron": "43.8.0",
    "electron-builder": "26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "markdown-it": "^14.3.0",
    "tailwindcss": "^4"
  },
  "overrides": {
    "@tiptap/extension-floating-menu": "$@tiptap/core"
  },
  "build": {
    "appId": "com.yuanshijilong.author",
    "productName": "Author",
    "artifactName": "author-setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "YuanShiJiLoong",
        "repo": "author"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!.agent",
          "!.agent/**/*",
          "!dist",
          "!dist/**/*",
          "!dist-*",
          "!dist-*/**/*",
          "!local-clients-v*",
          "!local-clients-v*/**/*",
          "!.git",
          "!.git/**/*",
          "!data",
          "!data/**/*",
          "!docs",
          "!docs/**/*",
          "!electron",
          "!electron/**/*",
          "!方案*",
          "!方案*/**/*",
          "!计划*",
          "!计划*/**/*",
          "!*草稿*",
          "!*草稿*/**/*",
          "!*draft*",
          "!*draft*/**/*",
          "!*.log",
          "!**/*.log",
          "!*.png",
          "!*.md",
          "!Caddyfile",
          "!Dockerfile",
          "!docker-compose*.yml",
          "!afterPack.js",
          "!eslint.config.mjs",
          "!jsconfig.json",
          "!postcss.config.mjs",
          "!next.config.mjs",
          "!package-lock.json",
          "!LICENSE",
          "!.npmrc",
          "!.env*",
          "!.gitignore",
          "!.dockerignore"
        ]
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "standalone/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "./afterPack.js",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}
